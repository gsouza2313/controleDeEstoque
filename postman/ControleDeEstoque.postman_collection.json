					"raw": "{{baseUrl}}/products",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"products"
					]
				}
			},
			"response": []
		},
		{
			"name": "4. Buscar Produto (Verificar Dados do Fornecedor)",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Status code is 200\", function () {",
							"    pm.response.to.have.status(200);",
							"});",
							"const jsonData = pm.response.json();",
							"pm.test(\"Dados do fornecedor vêm junto no produto\", function () {",
							"    pm.expect(jsonData).to.have.property(\"supplier\");",
							"    pm.expect(jsonData.supplier).to.be.an(\"object\");",
							"    pm.expect(jsonData.supplier.id).to.eql(pm.collectionVariables.get(\"supplierId\"));",
							"    pm.expect(jsonData.supplier.name).to.eql(\"Fornecedor Tech Ltda\");",
							"});"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "GET",
				"header": [],
				"url": {
					"raw": "{{baseUrl}}/products/{{productId}}",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"products",
						"{{productId}}"
					]
				}
			},
			"response": []
		},
