    "/v1/suppliers": {
        "post": {
            "tags": ["Supplier"],
            "summary": "Criar novo fornecedor",
            "description": "Criar um novo fornecedor",
            "security": [
                {
                    "bearerAuth": []
                }
            ],
            "requestBody": {
                "required": true,
                "description": "Dados necessários para a criação de um novo fornecedor",
                "content": {
                    "application/json": {
                        "schema": {
                            "$ref": "#/components/schemas/RequestCreateSupplier"
                        }
                    }
                }
            },
            "responses": {
                "201": {
                    "description": "Fornecedor criado com sucesso",
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/ResponseSupplier"
                            }
                        }
                    }
                },
                "400": {
                    "description": "Erro de validação",
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/ErrorResponse"
                            }
                        }
                    }
                },
                "401": {
                    "description": "Não autorizado"
                }
            }
        },
        "get": {
            "tags": ["Supplier"],
            "summary": "Listar fornecedores",
            "description": "Listar todos os fornecedores cadastrados",
            "security": [
                {
                    "bearerAuth": []
                }
            ],
            "responses": {
                "200": {
                    "description": "Lista de fornecedores",
                    "content": {
                        "application/json": {
                            "schema": {
                                "type": "array",
                                "items": {
                                    "$ref": "#/components/schemas/ResponseSupplier"
                                }
                            }
                        }
                    }
                },
                "401": {
                    "description": "Não autorizado"
                }
            }
        }
    },
    "/v1/suppliers/{id}": {
        "get": {
            "tags": ["Supplier"],
            "summary": "Buscar fornecedor por ID",
            "description": "Busca os detalhes de um fornecedor pelo seu ID",
            "security": [
                {
                    "bearerAuth": []
                }
            ],
            "parameters": [
                {
                    "name": "id",
                    "in": "path",
                    "description": "ID do fornecedor",
                    "required": true,
                    "schema": {
                        "type": "string",
                        "format": "uuid"
                    }
                }
            ],
            "responses": {
                "200": {
                    "description": "Dados do fornecedor",
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/ResponseSupplier"
                            }
                        }
                    }
                },
                "400": {
                    "description": "Fornecedor não encontrado ou ID inválido",
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/ErrorResponse"
                            }
                        }
                    }
                },
                "401": {
                    "description": "Não autorizado"
                }
            }
        },
        "patch": {
            "tags": ["Supplier"],
            "summary": "Atualizar fornecedor",
            "description": "Atualiza os dados de um fornecedor pelo seu ID",
            "security": [
                {
                    "bearerAuth": []
                }
            ],
            "parameters": [
                {
                    "name": "id",
                    "in": "path",
                    "description": "ID do fornecedor",
                    "required": true,
                    "schema": {
                        "type": "string",
                        "format": "uuid"
                    }
                }
            ],
            "requestBody": {
                "required": true,
                "description": "Dados para atualização do fornecedor",
                "content": {
                    "application/json": {
                        "schema": {
                            "$ref": "#/components/schemas/RequestEditSupplier"
                        }
                    }
                }
            },
            "responses": {
                "200": {
                    "description": "Fornecedor atualizado com sucesso",
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/ResponseSupplier"
                            }
                        }
                    }
                },
                "400": {
                    "description": "Erro de validação ou fornecedor não encontrado",
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/ErrorResponse"
                            }
                        }
                    }
                },
                "401": {
                    "description": "Não autorizado"
                }
            }
        },
        "delete": {
            "tags": ["Supplier"],
            "summary": "Remover fornecedor",
            "description": "Remove um fornecedor pelo seu ID",
            "security": [
                {
                    "bearerAuth": []
                }
            ],
            "parameters": [
                {
                    "name": "id",
                    "in": "path",
                    "description": "ID do fornecedor",
                    "required": true,
                    "schema": {
                        "type": "string",
                        "format": "uuid"
                    }
                }
            ],
            "responses": {
                "200": {
                    "description": "Fornecedor removido com sucesso",
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/ResponseDeleteSupplier"
                            }
                        }
                    }
                },
                "400": {
                    "description": "Fornecedor não encontrado ou ID inválido",
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/ErrorResponse"
                            }
                        }
                    }
                },
                "401": {
                    "description": "Não autorizado"
                }
            }
        }
    }
  },
